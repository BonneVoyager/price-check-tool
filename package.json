{
  "name": "openocean-playground",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && bun static.ts",
    "build": "bun build src/browser.ts --outfile public/app.js --target browser --minify",
    "quote": "bun src/cli.ts quote",
    "swap": "bun src/cli.ts swap",
    "tokens": "bun src/cli.ts tokens",
    "chains": "bun src/cli.ts chains",
    "gas": "bun src/cli.ts gas",
    "typecheck": "tsc --noEmit",
    "compare": "bun src/cli.ts compare"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}